{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Code Analysis Agent",
          "version": "1.0.0",
          "informationUri": "https://github.com/code-analysis-agent",
          "rules": [
            {
              "id": "CA0001",
              "name": "High cyclomatic complexity: bad_function",
              "shortDescription": {
                "text": "Function has cyclomatic complexity 17 (threshold: 15)"
              },
              "fullDescription": {
                "text": "Decompose into smaller functions; extract conditional logic"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "complexity"
              }
            },
            {
              "id": "CA0002",
              "name": "Low maintainability index: 31.1",
              "shortDescription": {
                "text": "File maintainability index below threshold (65)"
              },
              "fullDescription": {
                "text": "Reduce complexity, improve naming, add documentation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "complexity"
              }
            },
            {
              "id": "CA0003",
              "name": "Excessive nesting depth: 17",
              "shortDescription": {
                "text": "Maximum nesting depth exceeds threshold (4)"
              },
              "fullDescription": {
                "text": "Extract nested logic into functions; use guard clauses"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "complexity"
              }
            },
            {
              "id": "CA0004",
              "name": "Unknown",
              "shortDescription": {
                "text": ""
              },
              "fullDescription": {
                "text": "Use environment variables or secret management system"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "security"
              }
            },
            {
              "id": "CA0005",
              "name": "No test files found",
              "shortDescription": {
                "text": "Repository has 1 source files but no test files"
              },
              "fullDescription": {
                "text": "Add unit tests for critical functionality"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "testing"
              }
            },
            {
              "id": "CA0006",
              "name": "Too many parameters: bad_function",
              "shortDescription": {
                "text": "Function has 16 parameters (threshold: 5)"
              },
              "fullDescription": {
                "text": "Use parameter object or dataclass"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability"
              }
            },
            {
              "id": "CA0007",
              "name": "High cognitive complexity: bad_function",
              "shortDescription": {
                "text": "Function cognitive complexity is 17"
              },
              "fullDescription": {
                "text": "Simplify conditional logic; extract methods"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability"
              }
            },
            {
              "id": "CA0008",
              "name": "Large class: GodClass",
              "shortDescription": {
                "text": "Class has 30 methods (threshold: 20)"
              },
              "fullDescription": {
                "text": "Split class; apply Single Responsibility Principle"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability"
              }
            },
            {
              "id": "CA0009",
              "name": "Missing function docstring: process_user_input",
              "shortDescription": {
                "text": "Public function lacks docstring"
              },
              "fullDescription": {
                "text": "Add docstring describing purpose, args, returns, and exceptions"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "documentation"
              }
            },
            {
              "id": "CA0010",
              "name": "Missing class docstring: GodClass",
              "shortDescription": {
                "text": "Class lacks docstring"
              },
              "fullDescription": {
                "text": "Add class docstring describing purpose and usage"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "documentation"
              }
            },
            {
              "id": "CA0011",
              "name": "Missing README file",
              "shortDescription": {
                "text": "Repository lacks a README.md"
              },
              "fullDescription": {
                "text": "Add README with project overview, installation, usage, and contributing"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "documentation"
              }
            },
            {
              "id": "CA0012",
              "name": "Missing LICENSE file",
              "shortDescription": {
                "text": "Repository does not have a license file"
              },
              "fullDescription": {
                "text": "Add LICENSE file with appropriate open source license"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "documentation"
              }
            }
          ]
        }
      },
